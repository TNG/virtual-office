{
  "name": "virtual_office_server",
  "description": "Virtual Office Server",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "test": "jest",
    "format": "cd .. && npm run format",
    "start": "node build/server/index.js",
    "serve:e2e": "nodemon --exec 'tsx -r dotenv/config ./index.ts dotenv_config_path=../cypress/.env.test'",
    "start:e2e": "node --experimental-detect-module --import dotenv/config build/server/index.js dotenv_config_path=../cypress/.env.test",
    "generateTestData": "tsx ./generateTestData.ts"
  },
  "dependencies": {
    "@slack/web-api": "^7.0.0",
    "axios": "^1.0.0",
    "body-parser": "1.20.4",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "^16.0.0",
    "express": "4.22.1",
    "express-async-handler": "1.2.0",
    "express-basic-auth": "1.2.1",
    "lodash": "4.18.1",
    "luxon": "^3.0.0",
    "passport": "0.7.0",
    "passport-http": "0.3.0",
    "passport-oauth2": "1.8.0",
    "passport-slack-oauth2": "1.2.0",
    "pino": "^9.0.0",
    "pino-pretty": "^12.0.0",
    "reflect-metadata": "0.2.2",
    "socket.io": "4.8.1",
    "swagger-ui-express": "^5.0.0",
    "typedi": "0.10.0",
    "uuid": "^11.0.0"
  },
  "engines": {
    "node": "24.x",
    "npm": "10.x"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "^14.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jest": "^30.0.0",
    "@types/lodash": "4.17.24",
    "@types/node": "^24.13.2",
    "@types/passport": "1.0.9",
    "@types/passport-http": "0.3.11",
    "@types/socket.io": "3.0.2",
    "@types/supertest": "^6.0.0",
    "jest": "^30.0.0",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.0.0",
    "supertest": "^7.0.0",
    "ts-essentials": "9.4.2",
    "ts-jest": "^30.0.0",
    "ts-mockito": "2.6.1",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
